{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audited financial record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id",
    "company_name",
    "fiscal_year",
    "fiscal_year_end",
    "publication_date",
    "audited",
    "original_verified",
    "auditor_evidence_pdf_page",
    "source_url",
    "pdf_filename",
    "status",
    "review_notes",
    "net_income_measure",
    "net_income_basis",
    "net_income_derivation",
    "revenue",
    "net_income",
    "total_assets"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "company_name": {
      "type": "string",
      "minLength": 1
    },
    "fiscal_year": {
      "type": "integer"
    },
    "fiscal_year_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "audited": {
      "type": "boolean"
    },
    "original_verified": {
      "type": "boolean"
    },
    "auditor_evidence_pdf_page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "pdf_filename": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "status": {
      "enum": [
        "needs_manual_input",
        "ready"
      ]
    },
    "review_notes": {
      "type": "string"
    },
    "net_income_measure": {
      "enum": [
        "reported_net_income",
        "total_comprehensive_income",
        "other_comprehensive_income",
        "other",
        "unresolved"
      ],
      "description": "Candidate measure classification. Only reported_net_income can pass validation for a numeric net income output; other measures require manual input."
    },
    "net_income_basis": {
      "enum": [
        "consolidated_total",
        "attributable_to_owners",
        "unresolved"
      ]
    },
    "net_income_derivation": {
      "type": "string",
      "description": "Explain the exact reported consolidated net income/loss line, units, and page. Supporting audited components may explain the reported result, but must never replace it with a calculated estimate or comprehensive income."
    },
    "revenue": {
      "$ref": "#/$defs/metric"
    },
    "net_income": {
      "$ref": "#/$defs/metric"
    },
    "total_assets": {
      "$ref": "#/$defs/metric"
    },
    "auditor_report_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "auditor_evidence_locator": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "currency",
        "unit_multiplier",
        "pdf_page",
        "printed_page",
        "source_label",
        "status",
        "review_note"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Signed amount exactly as reported, before multiplying by unit_multiplier."
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "unit_multiplier": {
          "enum": [
            1,
            1000,
            1000000,
            1000000000,
            null
          ]
        },
        "pdf_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "printed_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "needs_manual_input",
            "ready"
          ]
        },
        "review_note": {
          "type": "string"
        },
        "source_locator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
